{
  "name": "football-db-app",
  "version": "1.1.0",
  "description": "Football predictions backend powered only by a local PostgreSQL database with automatic updates from open datasets.",
  "main": "src/app.js",
  "type": "module",
  "scripts": {
    "start": "node src/app.js",
    "dev": "node --watch src/app.js",
    "db:init": "psql $DATABASE_URL -f sql/schema.sql && psql $DATABASE_URL -f sql/views.sql",
    "import:seed": "node scripts/import-seed.js",
    "import:daily": "node scripts/import-daily.js",
    "recalc": "node scripts/recalculate-features.js"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "csv-parse": "^5.6.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pg": "^8.13.1"
  }
}
